# All optional. On Vercel, RPTScan calls Claude through Vercel AI Gateway using
# the deployment's OIDC token, so no key is required there.
# ANTHROPIC_API_KEY: call the Anthropic API directly (takes precedence).
ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY: use AI Gateway from local development.
AI_GATEWAY_API_KEY=
# Model override (default claude-opus-5-5 direct, anthropic/claude-opus-5 via gateway)
ANTHROPIC_MODEL=
